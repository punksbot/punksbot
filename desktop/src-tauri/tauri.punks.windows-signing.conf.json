{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "createUpdaterArtifacts": false,
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "../../scripts/windows-artifact-sign.ps1",
          "%1"
        ]
      }
    }
  }
}
