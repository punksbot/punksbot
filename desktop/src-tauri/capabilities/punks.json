{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "punks",
  "description": "Minimal capability for the Punks social desktop distribution",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "opener:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart"
  ]
}
