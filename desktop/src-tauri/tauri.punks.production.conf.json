{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Punks Bot",
  "mainBinaryName": "punks-bot",
  "version": "0.6.0",
  "identifier": "bot.punks.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "security": {
      "capabilities": ["punks"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/punksbot/punksbot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MTFCOEFFQTQyRjBDQTUKUldTbERDK2tycmdSMXJINFZUSWt3bkFWS3o4Y1EyazRrazBCbXV1M2FSSUY4M1dqSDZBUlIrKzYK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["punks"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "macOS": {
      "infoPlist": "Info.punks.plist"
    }
  }
}
