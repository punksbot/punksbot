{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-runtime.reaction-result@1",
  "title": "InvokeBotRuntimeReactionResult",
  "$comment": "Bounded private runtime result. Credentials and caller-provided capabilities never cross this interface.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "ok",
        "invocationId",
        "actionId",
        "admissionId",
        "replayed"
      ],
      "properties": {
        "contract": { "const": "bot-runtime.reaction-result@1" },
        "ok": { "const": true },
        "invocationId": { "$ref": "#/$defs/opaqueUuid" },
        "actionId": { "$ref": "#/$defs/opaqueUuid" },
        "admissionId": { "$ref": "#/$defs/opaqueUuid" },
        "replayed": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "ok", "code"],
      "properties": {
        "contract": { "const": "bot-runtime.reaction-result@1" },
        "ok": { "const": false },
        "code": {
          "enum": [
            "invalid_request",
            "credential_unavailable",
            "action_rejected",
            "temporarily_unavailable"
          ]
        }
      }
    }
  ],
  "$defs": {
    "opaqueUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
