{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/punk@1",
  "title": "Punk",
  "$comment": "Historical identity records remain readable, including retired passkey metadata. Active authentication and profile projections expose only Google/GitHub (ADR-0064).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "displayName",
    "avatarUrl",
    "identities",
    "mergedInto",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["active", "merged", "deleting", "deleted"] },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "avatarUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        { "type": "null" }
      ]
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "subjectHash",
          "emailHash",
          "verifiedEmail",
          "username",
          "credentialId",
          "linkedAt"
        ],
        "properties": {
          "provider": { "enum": ["google", "github", "passkey"] },
          "subjectHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "emailHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verifiedEmail": {
            "anyOf": [
              { "type": "string", "format": "email", "maxLength": 320 },
              { "type": "null" }
            ]
          },
          "username": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 255 },
              { "type": "null" }
            ]
          },
          "credentialId": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 2048 },
              { "type": "null" }
            ]
          },
          "linkedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "mergedInto": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
