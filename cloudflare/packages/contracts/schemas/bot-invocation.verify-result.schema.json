{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-invocation.verify-result@1",
  "title": "VerifyBotInvocationCredentialResult",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "principal"],
      "properties": {
        "ok": { "const": true },
        "principal": { "$ref": "#/$defs/claims" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "code"],
      "properties": {
        "ok": { "const": false },
        "code": {
          "enum": [
            "invalid_request",
            "invalid_credential",
            "expired",
            "not_yet_valid",
            "configuration_invalid"
          ]
        }
      }
    }
  ],
  "$defs": {
    "opaqueUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "environment",
        "audience",
        "kid",
        "jti",
        "invocationId",
        "workspaceId",
        "installationId",
        "botId",
        "authorityGeneration",
        "issuedAt",
        "notBefore",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "environment": { "enum": ["local", "staging", "production"] },
        "audience": { "const": "punks-bot-action" },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "jti": { "$ref": "#/$defs/opaqueUuid" },
        "invocationId": { "$ref": "#/$defs/opaqueUuid" },
        "workspaceId": { "$ref": "#/$defs/opaqueUuid" },
        "installationId": { "$ref": "#/$defs/opaqueUuid" },
        "botId": { "$ref": "#/$defs/opaqueUuid" },
        "authorityGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "notBefore": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expiresAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
