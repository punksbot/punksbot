{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/conversation.journal-segment@1",
  "title": "ConversationJournalSegmentArchive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "conversationId",
    "startCursor",
    "endCursor",
    "previousSegmentHash",
    "segmentHash",
    "events",
    "seal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "startCursor": { "type": "integer", "minimum": 1 },
    "endCursor": { "type": "integer", "minimum": 1 },
    "previousSegmentHash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "segmentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "created_at": { "type": "integer", "minimum": 0 },
          "kind": { "type": "integer", "minimum": 50000, "maximum": 59999 },
          "tags": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "maxLength": 2048 }
            }
          },
          "content": { "type": "string", "maxLength": 262144 },
          "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "const": 50104 },
        "tags": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 262144 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
