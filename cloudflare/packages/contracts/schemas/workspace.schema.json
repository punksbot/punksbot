{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace@1",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "visibility",
    "status",
    "ownerPunkId",
    "members",
    "revision",
    "cursor",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "visibility": { "enum": ["private", "punks", "public"] },
    "status": { "enum": ["active", "deleting", "deleted"] },
    "ownerPunkId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["punkId", "role"],
        "properties": {
          "punkId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "role": { "enum": ["owner", "moderator", "member", "guest"] }
        }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "cursor": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
