{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/desktop.compatibility@1",
  "title": "DesktopCompatibilityQuery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile",
    "clientVersion",
    "distribution",
    "platform"
  ],
  "properties": {
    "contract": { "const": "desktop.compatibility@1" },
    "profile": { "const": "desktop-social-loop@1" },
    "clientVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "distribution": {
      "enum": ["development", "staging", "production"]
    },
    "platform": {
      "enum": ["macos-arm64", "macos-x64", "linux-x64", "windows-x64"]
    }
  }
}
