{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace.governance-view@1",
  "title": "WorkspaceGovernanceView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "slug",
    "name",
    "visibility",
    "status",
    "ownerPunkId",
    "memberCount",
    "revision",
    "cursor",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contract": { "const": "workspace.governance-view@1" },
    "id": { "type": "string", "format": "uuid" },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "visibility": { "enum": ["private", "punks", "public"] },
    "status": { "const": "active" },
    "ownerPunkId": { "type": "string", "format": "uuid" },
    "memberCount": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "cursor": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
