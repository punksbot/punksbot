{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-action.receipt-archive@1",
  "title": "BotActionReceiptArchive",
  "$comment": "Bounded immutable terminal receipt. Credentials, JTI values, action payloads and Bot configuration are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "terminalAdmission",
    "admissionProof50320",
    "completionProof50321"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "terminalAdmission": { "$ref": "#/$defs/terminalAdmission" },
    "admissionProof50320": {
      "allOf": [
        { "$ref": "#/$defs/boundedSignedEvent" },
        { "properties": { "kind": { "const": 50320 } } }
      ]
    },
    "completionProof50321": {
      "allOf": [
        { "$ref": "#/$defs/boundedSignedEvent" },
        { "properties": { "kind": { "const": 50321 } } }
      ]
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminalAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actionId",
        "actionDigest",
        "workspaceId",
        "installationId",
        "botId",
        "actionContract",
        "capability",
        "risk",
        "resource",
        "status",
        "outcome",
        "installationCursor",
        "authorityGeneration",
        "admittedCursor",
        "completedCursor",
        "admittedAt",
        "completedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "actionDigest": { "$ref": "#/$defs/hash" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "installationId": { "$ref": "#/$defs/uuid" },
        "botId": { "$ref": "#/$defs/uuid" },
        "actionContract": {
          "enum": [
            "message.reaction-add@1",
            "message.reaction-remove@1",
            "message.reaction-toggle@1"
          ]
        },
        "capability": { "const": "messages.react" },
        "risk": { "enum": ["routine", "consequential", "critical"] },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "conversationId", "messageId"],
          "properties": {
            "kind": { "const": "message" },
            "conversationId": { "$ref": "#/$defs/uuid" },
            "messageId": { "$ref": "#/$defs/uuid" }
          }
        },
        "status": { "const": "completed" },
        "outcome": { "enum": ["succeeded", "failed"] },
        "installationCursor": { "type": "integer", "minimum": 1 },
        "authorityGeneration": { "type": "integer", "minimum": 1 },
        "admittedCursor": { "type": "integer", "minimum": 1 },
        "completedCursor": { "type": "integer", "minimum": 1 },
        "admittedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "boundedSignedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "pubkey": { "$ref": "#/$defs/hash" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "enum": [50320, 50321] },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 8192 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
