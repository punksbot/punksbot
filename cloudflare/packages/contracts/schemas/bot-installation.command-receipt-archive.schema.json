{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-installation.command-receipt-archive@1",
  "title": "BotInstallationCommandReceiptArchive",
  "$comment": "Bounded immutable terminal management receipt. Exact committed replay includes the first-release public empty config only; this schema deliberately rejects every non-empty config, command, credential, JTI, grant roster and arbitrary payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "aggregate",
    "installationId",
    "commandId",
    "payloadHash",
    "terminal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "aggregate": { "const": "bot-installation" },
    "installationId": { "type": "string", "format": "uuid" },
    "commandId": { "type": "string", "format": "uuid" },
    "payloadHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminal": {
      "oneOf": [
        { "$ref": "#/$defs/committed" },
        { "$ref": "#/$defs/rejected" }
      ]
    }
  },
  "$defs": {
    "committed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "committed" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "event"],
          "properties": {
            "state": { "$ref": "#/$defs/installation" },
            "event": { "$ref": "#/$defs/boundedSignedEvent" }
          }
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code"],
      "properties": {
        "kind": { "const": "rejected" },
        "code": {
          "enum": [
            "not_found",
            "forbidden",
            "invalid_transition",
            "conflict"
          ]
        }
      }
    },
    "boundedSignedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "enum": [50310, 50311, 50312] },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 65536 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workspaceId",
        "botId",
        "status",
        "config",
        "grantCount",
        "openAdmissionCount",
        "authorityGeneration",
        "revision",
        "cursor",
        "createdAt",
        "updatedAt",
        "revokedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "workspaceId": { "type": "string", "format": "uuid" },
        "botId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["active", "revoked"] },
        "runtimeRelease": {
          "oneOf": [
            { "$ref": "#/$defs/runtimeReleaseRef" },
            { "type": "null" }
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "value"],
          "properties": {
            "contractId": {
              "const": "punks://contracts/bot.config.empty@1"
            },
            "value": {
              "type": "object",
              "additionalProperties": false
            }
          }
        },
        "grantCount": { "type": "integer", "minimum": 0 },
        "openAdmissionCount": { "type": "integer", "minimum": 0 },
        "authorityGeneration": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "revokedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": { "properties": { "revokedAt": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "revoked" } } },
          "then": {
            "properties": {
              "revokedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "runtimeReleaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseDigest"],
      "properties": {
        "releaseId": { "const": "punks.reaction-turn.v1" },
        "releaseDigest": {
          "const": "fe075600eab020932774516439f643e8b83f62a10245e6388ee25bbf61aa837f"
        }
      }
    }
  }
}
