{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace.projection@1",
  "title": "WorkspaceProjectionMessage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "cursor", "event", "state"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "cursor": { "type": "integer", "minimum": 1 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "type": "integer", "minimum": 50000, "maximum": 59999 },
        "tags": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 262144 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "visibility",
        "status",
        "ownerPunkId",
        "members",
        "revision",
        "cursor",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 48 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visibility": { "enum": ["private", "punks", "public"] },
        "status": { "enum": ["active", "deleting", "deleted"] },
        "ownerPunkId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["punkId", "role"],
            "properties": {
              "punkId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "role": { "enum": ["owner", "moderator", "member", "guest"] }
            }
          }
        },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
