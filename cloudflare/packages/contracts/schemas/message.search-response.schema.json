{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/message.search-response@1",
  "title": "MessageSearchResponse",
  "$comment": "Runtime invariants: serialized UTF-8 is at most 1048576 bytes; every item is an authorized active MessageView in this Workspace, Conversation and nullable thread scope and still matches the current decrypted version; items follow createdCursor DESC, conversationId ASC, messageId ASC so createdCursor is non-increasing. A complete page has partialReason null. A partial page has the typed reason index_lagging or index_unavailable and never falls back to another authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "conversationId",
    "threadRootMessageId",
    "order",
    "completeness",
    "partialReason",
    "items",
    "nextCursor"
  ],
  "properties": {
    "workspaceId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "threadRootMessageId": {
      "anyOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    },
    "order": { "const": "createdCursor-descending" },
    "completeness": { "enum": ["complete", "partial"] },
    "partialReason": {
      "anyOf": [
        { "enum": ["index_lagging", "index_unavailable"] },
        { "type": "null" }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "schemas/message.view.schema.json" },
          {
            "required": ["status"],
            "properties": { "status": { "const": "active" } }
          }
        ]
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 50,
          "maxLength": 1024,
          "pattern": "^msc1\\.[A-Za-z0-9_-]{16}\\.[A-Za-z0-9_-]+$"
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "completeness": { "const": "complete" } },
        "required": ["completeness"]
      },
      "then": { "properties": { "partialReason": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "completeness": { "const": "partial" } },
        "required": ["completeness"]
      },
      "then": {
        "properties": {
          "partialReason": {
            "enum": ["index_lagging", "index_unavailable"]
          }
        }
      }
    }
  ]
}
