{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/conversation.view@1",
  "title": "ConversationView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "name",
    "type",
    "visibility",
    "description",
    "topic",
    "purpose",
    "topicRequired",
    "maxMembers",
    "ttlSeconds",
    "ttlDeadline",
    "status",
    "revision",
    "cursor",
    "createdAt",
    "updatedAt",
    "archivedAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "type": { "enum": ["stream", "forum", "dm", "workflow"] },
    "visibility": { "enum": ["open", "private"] },
    "description": { "anyOf": [{ "type": "string", "maxLength": 4000 }, { "type": "null" }] },
    "topic": { "anyOf": [{ "type": "string", "maxLength": 255 }, { "type": "null" }] },
    "purpose": { "anyOf": [{ "type": "string", "maxLength": 4000 }, { "type": "null" }] },
    "topicRequired": { "type": "boolean" },
    "maxMembers": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 100000 }, { "type": "null" }] },
    "ttlSeconds": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "type": "null" }] },
    "ttlDeadline": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "status": { "enum": ["active", "archived", "deleting", "deleted"] },
    "revision": { "type": "integer", "minimum": 1 },
    "cursor": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "archivedAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
  }
}
