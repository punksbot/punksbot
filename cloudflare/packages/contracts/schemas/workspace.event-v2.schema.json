{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace.event@2",
  "title": "WorkspaceEventContentV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspace",
    "transition",
    "membershipCommitment"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workspace": { "$ref": "#/$defs/workspaceMetadata" },
    "transition": { "$ref": "#/$defs/transition" },
    "membershipCommitment": { "$ref": "#/$defs/membershipCommitment" }
  },
  "$defs": {
    "workspaceRole": {
      "enum": ["owner", "moderator", "member", "guest"]
    },
    "nullableWorkspaceRole": {
      "oneOf": [{ "$ref": "#/$defs/workspaceRole" }, { "type": "null" }]
    },
    "workspaceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "visibility",
        "status",
        "ownerPunkId",
        "memberCount",
        "revision",
        "cursor",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visibility": { "enum": ["private", "punks", "public"] },
        "status": { "enum": ["active", "deleting", "deleted"] },
        "ownerPunkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "membershipCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "deltaDigest",
        "deltaCount",
        "chunkCount",
        "chunkDigests"
      ],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json" },
        "deltaDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "deltaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "chunkCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "chunkDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "memberUpsertedTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetPunkId", "previousRole", "role"],
      "properties": {
        "type": { "const": "member-upserted" },
        "targetPunkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "previousRole": { "$ref": "#/$defs/nullableWorkspaceRole" },
        "role": { "$ref": "#/$defs/workspaceRole" }
      }
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "created" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "previousSlug"],
          "properties": {
            "type": { "const": "renamed" },
            "previousSlug": {
              "type": "string",
              "minLength": 2,
              "maxLength": 48
            }
          }
        },
        { "$ref": "#/$defs/memberUpsertedTransition" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetPunkId", "previousRole"],
          "properties": {
            "type": { "const": "member-removed" },
            "targetPunkId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "previousRole": { "$ref": "#/$defs/workspaceRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "memberTransitions"],
          "properties": {
            "type": { "const": "ownership-transferred" },
            "memberTransitions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/memberUpsertedTransition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "planId",
            "receiptId",
            "survivorPunkId",
            "absorbedPunkId",
            "survivorPreviousRole",
            "absorbedPreviousRole",
            "resultingRole"
          ],
          "properties": {
            "type": { "const": "account-merge-applied" },
            "planId": { "type": "string", "format": "uuid" },
            "receiptId": { "type": "string", "format": "uuid" },
            "survivorPunkId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "absorbedPunkId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "survivorPreviousRole": {
              "$ref": "#/$defs/nullableWorkspaceRole"
            },
            "absorbedPreviousRole": { "$ref": "#/$defs/workspaceRole" },
            "resultingRole": { "$ref": "#/$defs/workspaceRole" }
          }
        }
      ]
    }
  }
}
