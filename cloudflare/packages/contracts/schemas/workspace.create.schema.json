{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace.create@1",
  "title": "CreateWorkspaceCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "commandId", "actor", "payload"],
  "properties": {
    "contract": { "const": "workspace.create@1" },
    "commandId": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "punkId"],
      "properties": {
        "kind": { "const": "punk" },
        "punkId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "visibility"],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visibility": { "enum": ["private", "punks", "public"] }
      }
    }
  }
}
