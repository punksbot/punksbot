{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot.publish@1",
  "title": "PublishBotCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "commandId", "actor", "payload"],
  "properties": {
    "contract": { "const": "bot.publish@1" },
    "commandId": { "type": "string", "format": "uuid" },
    "actor": { "$ref": "#/$defs/actor" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "punkId"],
      "properties": {
        "kind": { "const": "punk" },
        "punkId": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "description",
        "configContractId",
        "runtimeRelease",
        "supportedActionContracts"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 4000 },
        "configContractId": {
          "const": "punks://contracts/bot.config.empty@1"
        },
        "runtimeRelease": { "$ref": "#/$defs/runtimeReleaseRef" },
        "supportedActionContracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "message.reaction-add@1",
              "message.reaction-remove@1",
              "message.reaction-toggle@1"
            ]
          }
        }
      }
    },
    "runtimeReleaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseDigest"],
      "properties": {
        "releaseId": { "const": "punks.reaction-turn.v1" },
        "releaseDigest": {
          "const": "fe075600eab020932774516439f643e8b83f62a10245e6388ee25bbf61aa837f"
        }
      }
    }
  }
}
