{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/auth.desktop-start@1",
  "title": "StartDesktopAuthCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "provider", "intent", "installationId", "environment"],
  "properties": {
    "contract": { "const": "auth.desktop-start@1" },
    "provider": { "enum": ["google", "github"] },
    "intent": { "const": "sign_in" },
    "installationId": {
        "type": "string",
        "format": "uuid"
      },
    "environment": { "enum": ["local", "staging", "production"] }
  }
}
