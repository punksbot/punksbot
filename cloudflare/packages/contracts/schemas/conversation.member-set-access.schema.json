{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/conversation.member-set-access@1",
  "title": "SetConversationMemberAccessCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "commandId", "workspaceId", "conversationId", "actor", "payload"],
  "properties": {
    "contract": { "const": "conversation.member-set-access@1" },
    "commandId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "punkId"],
      "properties": {
        "kind": { "const": "punk" },
        "punkId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPunkId", "access"],
      "properties": {
        "targetPunkId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "access": { "enum": ["manager", "member", "guest"] }
      }
    }
  }
}
