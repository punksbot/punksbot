{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/conversation.list@1",
  "title": "ListConversationsQuery",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "workspaceId", "type", "status", "limit", "cursor"],
  "properties": {
    "contract": { "const": "conversation.list@1" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "type": { "const": "stream" },
    "status": { "const": "active" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cursor": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,1024}$"
        },
        { "type": "null" }
      ]
    }
  }
}
