{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/message.reaction-remove@1",
  "title": "RemoveMessageReactionCommand",
  "$comment": "The normalized actor + Message + Reaction coordinate is unique. Missing or already removed presence is an idempotent no-op.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "commandId",
    "workspaceId",
    "conversationId",
    "messageId",
    "actor",
    "payload"
  ],
  "properties": {
    "contract": { "const": "message.reaction-remove@1" },
    "commandId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "conversationId": { "type": "string", "format": "uuid" },
    "messageId": { "type": "string", "format": "uuid" },
    "actor": { "$ref": "#/$defs/actor" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "punkId"],
          "properties": {
            "kind": { "const": "punk" },
            "punkId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "installationId"],
          "properties": {
            "kind": { "const": "bot" },
            "installationId": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction"],
      "properties": {
        "reaction": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64,
              "not": {
                "anyOf": [
                  { "pattern": "^:" },
                  { "pattern": ":$" },
                  { "pattern": "[\\r\\n\\u2028\\u2029]" }
                ]
              }
            },
            {
              "type": "string",
              "maxLength": 66,
              "pattern": "^:[A-Za-z0-9_-]{1,64}:$"
            }
          ]
        }
      }
    }
  }
}
