{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/journal.segment@2",
  "title": "MembershipJournalSegmentArchiveV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "startCursor",
    "endCursor",
    "previousSegmentHash",
    "segmentHash",
    "entries",
    "seal"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "startCursor": { "type": "integer", "minimum": 1 },
    "endCursor": { "type": "integer", "minimum": 1 },
    "previousSegmentHash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "segmentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cursor", "event", "chunks"],
        "properties": {
          "cursor": { "type": "integer", "minimum": 1 },
          "event": { "$ref": "schemas/nostr.signed-event.schema.json" },
          "chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "$ref": "#/$defs/workspaceProjectionChunk" }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pubkey",
        "created_at",
        "kind",
        "tags",
        "content",
        "sig"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "const": 50002 },
        "tags": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 262144 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  },
  "$defs": {
    "workspaceProjectionChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "workspaceId",
        "cursor",
        "chunkIndex",
        "chunkCount",
        "chunkDigest",
        "memberDeltas",
        "event"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "workspaceId": { "type": "string", "format": "uuid" },
        "cursor": { "type": "integer", "minimum": 1 },
        "chunkIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
        "chunkCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "chunkDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "memberDeltas": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["punkId", "present", "role"],
            "properties": {
              "punkId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "present": { "type": "boolean" },
              "role": { "enum": ["owner", "moderator", "member", "guest"] }
            }
          }
        },
        "event": { "$ref": "schemas/nostr.signed-event.schema.json" }
      }
    }
  }
}
