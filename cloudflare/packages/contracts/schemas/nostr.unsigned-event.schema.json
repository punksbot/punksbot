{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/nostr.unsigned-event@1",
  "title": "UnsignedNostrEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["created_at", "kind", "tags", "content"],
  "properties": {
    "created_at": { "type": "integer", "minimum": 0 },
    "kind": { "type": "integer", "minimum": 50000, "maximum": 59999 },
    "tags": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "maxLength": 2048 }
      }
    },
    "content": { "type": "string", "maxLength": 262144 }
  }
}
