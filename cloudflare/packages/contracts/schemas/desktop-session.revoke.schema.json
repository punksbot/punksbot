{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/desktop-session.revoke@1",
  "title": "DesktopSessionRevokeExchange",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "title": "DesktopSessionRevokeRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "message", "capability"],
      "properties": {
        "contract": { "const": "desktop-session.revoke@1" },
        "message": { "const": "request" },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,128}$"
        }
      }
    },
    "response": {
      "title": "DesktopSessionRevokeResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "message", "revoked", "expired"],
      "properties": {
        "contract": { "const": "desktop-session.revoke@1" },
        "message": { "const": "response" },
        "revoked": { "const": true },
        "expired": { "type": "boolean" }
      }
    }
  }
}
