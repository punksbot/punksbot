{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/account-merge.receipt@1",
  "title": "AccountMergeReceipt",
  "$comment": "Create-only minimal point-of-no-return proof. It contains no profile, identity value, Workspace inventory, credential, session token or handoff payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "receiptId",
    "intentId",
    "planId",
    "planDigest",
    "commitCommandId",
    "survivorPunkId",
    "absorbedPunkId",
    "accountRevisions",
    "committedAt",
    "receiptHash"
  ],
  "properties": {
    "contract": { "const": "account-merge.receipt@1" },
    "schemaVersion": { "const": 1 },
    "receiptId": { "$ref": "#/$defs/uuid" },
    "intentId": { "$ref": "#/$defs/uuid" },
    "planId": { "$ref": "#/$defs/uuid" },
    "planDigest": { "$ref": "#/$defs/hexDigest" },
    "commitCommandId": { "$ref": "#/$defs/uuid" },
    "survivorPunkId": { "$ref": "#/$defs/uuid" },
    "absorbedPunkId": { "$ref": "#/$defs/uuid" },
    "accountRevisions": { "$ref": "#/$defs/accountRevisions" },
    "committedAt": { "$ref": "#/$defs/timestamp" },
    "receiptHash": { "$ref": "#/$defs/hexDigest" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hexDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "accountRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["survivor", "absorbed"],
      "properties": {
        "survivor": { "$ref": "#/$defs/revision" },
        "absorbed": { "$ref": "#/$defs/revision" }
      }
    }
  }
}
