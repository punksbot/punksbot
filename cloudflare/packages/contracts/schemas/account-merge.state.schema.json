{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/account-merge.state@1",
  "title": "AccountMergeState",
  "$comment": "Bounded readable saga state. A receipt is mandatory from committed onward and makes every later phase roll-forward only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "intentId",
    "planId",
    "planDigest",
    "status",
    "survivorPunkId",
    "absorbedPunkId",
    "applicationCursor",
    "applicationTotal",
    "receipt",
    "lastFailure",
    "committedAt",
    "completedAt",
    "updatedAt"
  ],
  "properties": {
    "contract": { "const": "account-merge.state@1" },
    "schemaVersion": { "const": 1 },
    "intentId": { "$ref": "#/$defs/uuid" },
    "planId": { "$ref": "#/$defs/uuid" },
    "planDigest": { "$ref": "#/$defs/hexDigest" },
    "status": {
      "enum": ["planned", "preparing", "committed", "applying", "completed"]
    },
    "survivorPunkId": { "$ref": "#/$defs/uuid" },
    "absorbedPunkId": { "$ref": "#/$defs/uuid" },
    "applicationCursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "applicationTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "receipt": {
      "anyOf": [
        { "$ref": "#/$defs/receipt" },
        { "type": "null" }
      ]
    },
    "lastFailure": {
      "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
    },
    "committedAt": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "completedAt": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["planned", "preparing"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "receipt": { "type": "null" },
          "committedAt": { "type": "null" },
          "completedAt": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["committed", "applying"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "receipt": { "$ref": "#/$defs/receipt" },
          "committedAt": { "$ref": "#/$defs/timestamp" },
          "completedAt": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "receipt": { "$ref": "#/$defs/receipt" },
          "committedAt": { "$ref": "#/$defs/timestamp" },
          "completedAt": { "$ref": "#/$defs/timestamp" }
        }
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hexDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "accountRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["survivor", "absorbed"],
      "properties": {
        "survivor": { "$ref": "#/$defs/revision" },
        "absorbed": { "$ref": "#/$defs/revision" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schemaVersion",
        "receiptId",
        "intentId",
        "planId",
        "planDigest",
        "commitCommandId",
        "survivorPunkId",
        "absorbedPunkId",
        "accountRevisions",
        "committedAt",
        "receiptHash"
      ],
      "properties": {
        "contract": { "const": "account-merge.receipt@1" },
        "schemaVersion": { "const": 1 },
        "receiptId": { "$ref": "#/$defs/uuid" },
        "intentId": { "$ref": "#/$defs/uuid" },
        "planId": { "$ref": "#/$defs/uuid" },
        "planDigest": { "$ref": "#/$defs/hexDigest" },
        "commitCommandId": { "$ref": "#/$defs/uuid" },
        "survivorPunkId": { "$ref": "#/$defs/uuid" },
        "absorbedPunkId": { "$ref": "#/$defs/uuid" },
        "accountRevisions": { "$ref": "#/$defs/accountRevisions" },
        "committedAt": { "$ref": "#/$defs/timestamp" },
        "receiptHash": { "$ref": "#/$defs/hexDigest" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "correlationId", "recordedAt"],
      "properties": {
        "code": {
          "enum": [
            "plan_expired",
            "revision_conflict",
            "blocking_conflict",
            "authority_unavailable",
            "idempotency_conflict",
            "receipt_conflict",
            "application_pending"
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recordedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
