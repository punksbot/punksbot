{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot.command-receipt-archive@1",
  "title": "BotCommandReceiptArchive",
  "$comment": "Bounded immutable terminal Bot command receipt. The command, credentials, arbitrary payloads and Bot Installation configuration are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "aggregate",
    "botId",
    "commandId",
    "payloadHash",
    "terminal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "aggregate": { "const": "bot" },
    "botId": { "type": "string", "format": "uuid" },
    "commandId": { "type": "string", "format": "uuid" },
    "payloadHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminal": { "$ref": "#/$defs/committed" }
  },
  "$defs": {
    "committed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "committed" },
        "value": { "$ref": "#/$defs/value" }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "event", "previousSlug"],
      "properties": {
        "state": { "$ref": "#/$defs/bot" },
        "event": { "$ref": "#/$defs/boundedSignedEvent" },
        "previousSlug": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 48,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "boundedSignedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "enum": [50300, 50301] },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "maxLength": 2048 }
          }
        },
        "content": { "type": "string", "maxLength": 65536 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "status",
        "configContractId",
        "supportedActionContracts",
        "revision",
        "cursor",
        "createdAt",
        "updatedAt",
        "suspendedAt",
        "withdrawnAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 4000 },
        "status": { "enum": ["published", "suspended", "withdrawn"] },
        "configContractId": {
          "const": "punks://contracts/bot.config.empty@1"
        },
        "runtimeRelease": {
          "oneOf": [
            { "$ref": "#/$defs/runtimeReleaseRef" },
            { "type": "null" }
          ]
        },
        "supportedActionContracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "message.reaction-add@1",
              "message.reaction-remove@1",
              "message.reaction-toggle@1"
            ]
          }
        },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "suspendedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "withdrawnAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "published" } } },
          "then": {
            "properties": {
              "suspendedAt": { "type": "null" },
              "withdrawnAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "suspended" } } },
          "then": {
            "properties": {
              "suspendedAt": { "type": "string", "format": "date-time" },
              "withdrawnAt": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "withdrawn" } } },
          "then": {
            "properties": {
              "withdrawnAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      ]
    },
    "runtimeReleaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseDigest"],
      "properties": {
        "releaseId": { "const": "punks.reaction-turn.v1" },
        "releaseDigest": {
          "const": "fe075600eab020932774516439f643e8b83f62a10245e6388ee25bbf61aa837f"
        }
      }
    }
  }
}
