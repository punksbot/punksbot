{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-installation.journal-segment@1",
  "title": "BotInstallationJournalSegmentArchive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "installationId",
    "startCursor",
    "endCursor",
    "previousSegmentHash",
    "segmentHash",
    "events",
    "seal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "installationId": { "type": "string", "format": "uuid" },
    "startCursor": { "type": "integer", "minimum": 1 },
    "endCursor": { "type": "integer", "minimum": 1 },
    "previousSegmentHash": { "$ref": "#/$defs/nullableHash" },
    "segmentHash": { "$ref": "#/$defs/hash" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/signedEvent" }
    },
    "seal": { "$ref": "#/$defs/seal" }
  },
  "allOf": [
    {
      "if": {
        "required": ["previousSegmentHash"],
        "properties": { "previousSegmentHash": { "type": "null" } }
      },
      "then": {
        "properties": {
          "seal": {
            "properties": {
              "tags": { "$ref": "#/$defs/sealTagsWithoutPrevious" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "seal": {
            "properties": {
              "tags": { "$ref": "#/$defs/sealTagsWithPrevious" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHash": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
    },
    "genericTag": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "signedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "pubkey": { "$ref": "#/$defs/hash" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "enum": [50310, 50311, 50312, 50320, 50321] },
        "tags": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/genericTag" }
        },
        "content": { "type": "string", "maxLength": 262144 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "workspaceTag": {
      "type": "array",
      "prefixItems": [{ "const": "workspace" }, { "type": "string", "format": "uuid" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "installationTag": {
      "type": "array",
      "prefixItems": [{ "const": "installation" }, { "type": "string", "format": "uuid" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "startCursorTag": {
      "type": "array",
      "prefixItems": [{ "const": "start_cursor" }, { "type": "string", "pattern": "^[1-9][0-9]*$" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "endCursorTag": {
      "type": "array",
      "prefixItems": [{ "const": "end_cursor" }, { "type": "string", "pattern": "^[1-9][0-9]*$" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "segmentHashTag": {
      "type": "array",
      "prefixItems": [{ "const": "segment_hash" }, { "$ref": "#/$defs/hash" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "previousSegmentHashTag": {
      "type": "array",
      "prefixItems": [{ "const": "previous_segment_hash" }, { "$ref": "#/$defs/hash" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "attestationTag": {
      "type": "array",
      "prefixItems": [
        { "const": "attestation" },
        { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sealTagsWithoutPrevious": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/workspaceTag" },
        { "$ref": "#/$defs/installationTag" },
        { "$ref": "#/$defs/startCursorTag" },
        { "$ref": "#/$defs/endCursorTag" },
        { "$ref": "#/$defs/segmentHashTag" },
        { "$ref": "#/$defs/attestationTag" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "sealTagsWithPrevious": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/workspaceTag" },
        { "$ref": "#/$defs/installationTag" },
        { "$ref": "#/$defs/startCursorTag" },
        { "$ref": "#/$defs/endCursorTag" },
        { "$ref": "#/$defs/segmentHashTag" },
        { "$ref": "#/$defs/previousSegmentHashTag" },
        { "$ref": "#/$defs/attestationTag" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": { "$ref": "#/$defs/hash" },
        "pubkey": { "$ref": "#/$defs/hash" },
        "created_at": { "type": "integer", "minimum": 0 },
        "kind": { "const": 50313 },
        "tags": {
          "oneOf": [
            { "$ref": "#/$defs/sealTagsWithoutPrevious" },
            { "$ref": "#/$defs/sealTagsWithPrevious" }
          ]
        },
        "content": { "type": "string", "maxLength": 65536 },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
