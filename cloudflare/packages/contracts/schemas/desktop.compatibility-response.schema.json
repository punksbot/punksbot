{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/desktop.compatibility-response@1",
  "title": "DesktopCompatibilityResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "compatible",
    "profile",
    "registryVersion",
    "minimumClientVersion",
    "environment",
    "origin",
    "capabilities"
  ],
  "properties": {
    "contract": { "const": "desktop.compatibility-response@1" },
    "compatible": { "type": "boolean" },
    "profile": { "const": "desktop-social-loop@1" },
    "registryVersion": { "const": 1 },
    "minimumClientVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "environment": { "enum": ["local", "staging", "production"] },
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#]+$",
      "maxLength": 512
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 64
      }
    }
  }
}
