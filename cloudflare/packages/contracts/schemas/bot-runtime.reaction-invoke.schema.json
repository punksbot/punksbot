{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/bot-runtime.reaction-invoke@1",
  "title": "InvokeBotRuntimeReactionCommand",
  "$comment": "Private Punks runtime command. The exact Reaction contract is the discriminant; invocation identity, credential and capability are derived internally.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "workspaceId",
    "installationId",
    "botId",
    "actionId",
    "authorityGeneration",
    "action"
  ],
  "properties": {
    "contract": { "const": "bot-runtime.reaction-invoke@1" },
    "workspaceId": { "$ref": "#/$defs/opaqueUuid" },
    "installationId": { "$ref": "#/$defs/opaqueUuid" },
    "botId": { "$ref": "#/$defs/opaqueUuid" },
    "actionId": { "$ref": "#/$defs/opaqueUuid" },
    "authorityGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/reactionAdd" },
        { "$ref": "#/$defs/reactionRemove" },
        { "$ref": "#/$defs/reactionToggle" }
      ]
    }
  },
  "$defs": {
    "opaqueUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reactionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction"],
      "properties": {
        "reaction": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64,
              "not": {
                "anyOf": [
                  { "pattern": "^:" },
                  { "pattern": ":$" },
                  { "pattern": "[\\r\\n\\u2028\\u2029]" }
                ]
              }
            },
            {
              "type": "string",
              "maxLength": 66,
              "pattern": "^:[A-Za-z0-9_-]{1,64}:$"
            }
          ]
        }
      }
    },
    "reactionAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "conversationId", "messageId", "payload"],
      "properties": {
        "contract": { "const": "message.reaction-add@1" },
        "conversationId": { "$ref": "#/$defs/opaqueUuid" },
        "messageId": { "$ref": "#/$defs/opaqueUuid" },
        "payload": { "$ref": "#/$defs/reactionPayload" }
      }
    },
    "reactionRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "conversationId", "messageId", "payload"],
      "properties": {
        "contract": { "const": "message.reaction-remove@1" },
        "conversationId": { "$ref": "#/$defs/opaqueUuid" },
        "messageId": { "$ref": "#/$defs/opaqueUuid" },
        "payload": { "$ref": "#/$defs/reactionPayload" }
      }
    },
    "reactionToggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "conversationId", "messageId", "payload"],
      "properties": {
        "contract": { "const": "message.reaction-toggle@1" },
        "conversationId": { "$ref": "#/$defs/opaqueUuid" },
        "messageId": { "$ref": "#/$defs/opaqueUuid" },
        "payload": { "$ref": "#/$defs/reactionPayload" }
      }
    }
  }
}
