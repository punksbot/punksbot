{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/workspace.transfer-ownership@1",
  "title": "TransferWorkspaceOwnershipCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "commandId", "workspaceId", "actor", "payload"],
  "properties": {
    "contract": { "const": "workspace.transfer-ownership@1" },
    "commandId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "punkId"],
      "properties": {
        "kind": { "const": "punk" },
        "punkId": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPunkId", "expectedRevision", "reauthorizationId"],
      "properties": {
        "targetPunkId": { "type": "string", "format": "uuid" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "reauthorizationId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
