{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "punks://contracts/punk.summary@1",
  "title": "PunkPublicSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["punkId", "displayName", "avatarUrl"],
  "properties": {
    "punkId": { "type": "string", "format": "uuid" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "avatarUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        { "type": "null" }
      ]
    }
  }
}
