      "publish": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/ConversationFollowClientFrame"
            }
          ]
        },
        "operationId": "confirmFollowBatch"
      },
      "subscribe": {
        "message": {
          "oneOf": [
            {
              "$ref": "#/components/messages/ConversationFollowServerFrame"
            }
          ]
        },
        "operationId": "followConversation"
