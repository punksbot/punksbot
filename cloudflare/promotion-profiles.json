{
  "schema": "punks.promotion-profiles.v1",
  "profiles": [
    {
      "tranche": 1,
      "id": "desktop-social-loop@1",
      "stories": [
        "connexion",
        "workspace",
        "lecture-live",
        "pagination",
        "publication",
        "reponse",
        "sujet",
        "reactions"
      ],
      "authorities": [
        {
          "id": "auth-punk",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "PUNKS",
          "className": "PunkDO"
        },
        {
          "id": "auth-identity-claim",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "IDENTITY_CLAIMS",
          "className": "IdentityClaimDO"
        },
        {
          "id": "auth-email-claim",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "EMAIL_CLAIMS",
          "className": "EmailClaimDO"
        },
        {
          "id": "auth-transaction",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "AUTH_TRANSACTIONS",
          "className": "AuthTransactionDO"
        },
        {
          "id": "auth-desktop-flow",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "DESKTOP_AUTH_FLOWS",
          "className": "DesktopAuthFlowDO"
        },
        {
          "id": "auth-desktop-reauthorization",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "DESKTOP_REAUTH_GRANTS",
          "className": "DesktopReauthGrantDO"
        },
        {
          "id": "auth-session-revocation",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "SESSION_REVOCATIONS",
          "className": "SessionRevocationDO"
        },
        {
          "id": "auth-session-rotation",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "SESSION_ROTATIONS",
          "className": "SessionRotationDO"
        },
        {
          "id": "auth-session",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "SESSIONS",
          "className": "SessionDO"
        },
        {
          "id": "auth-passkey-ceremony",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "PASSKEY_CEREMONIES",
          "className": "PasskeyCeremonyDO"
        },
        {
          "id": "auth-passkey-credential",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "PASSKEY_CREDENTIALS",
          "className": "PasskeyCredentialDO"
        },
        {
          "id": "api-workspace",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "WORKSPACES",
          "className": "WorkspaceDO"
        },
        {
          "id": "api-workspace-slug",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "WORKSPACE_SLUGS",
          "className": "WorkspaceSlugDO"
        },
        {
          "id": "api-conversation",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "CONVERSATIONS",
          "className": "ConversationDO"
        },
        {
          "id": "api-message-content",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "MESSAGE_CONTENT",
          "className": "MessageContentDO"
        },
        {
          "id": "erasure-registry",
          "kind": "service",
          "worker": "punks-erasure-staging"
        },
        {
          "id": "internal-event-signature",
          "kind": "service",
          "worker": "punks-attestation-staging"
        }
