{
  "schema": "punks.promotion-profiles.v1",
  "profiles": [
    {
      "tranche": 1,
      "id": "desktop-social-loop@1",
      "stories": [
        "connexion",
        "workspace",
        "lecture-live",
        "pagination",
        "publication",
        "reponse",
        "sujet",
        "reactions"
      ],
      "authorities": [
        {
          "id": "auth-punk",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "PUNKS",
          "className": "PunkDO"
        },
        {
          "id": "auth-session-revocation",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "SESSION_REVOCATIONS",
          "className": "SessionRevocationDO"
        },
        {
          "id": "auth-session",
          "kind": "durable-object",
          "worker": "punks-auth-staging",
          "binding": "SESSIONS",
          "className": "SessionDO"
        },
        {
          "id": "api-workspace",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "WORKSPACES",
          "className": "WorkspaceDO"
        },
        {
          "id": "api-workspace-slug",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "WORKSPACE_SLUGS",
          "className": "WorkspaceSlugDO"
        },
        {
          "id": "api-conversation",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "CONVERSATIONS",
          "className": "ConversationDO"
        },
        {
          "id": "api-message-content",
          "kind": "durable-object",
          "worker": "punks-api-staging",
          "binding": "MESSAGE_CONTENT",
          "className": "MessageContentDO"
        },
        {
          "id": "erasure-registry",
          "kind": "service",
          "worker": "punks-erasure-staging"
        },
        {
          "id": "internal-event-signature",
          "kind": "service",
          "worker": "punks-attestation-staging"
        }
      ]
    }
  ]
}
