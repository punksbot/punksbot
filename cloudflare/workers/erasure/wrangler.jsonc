{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "account_id": "3a391620584c792dbbd8cfa148d7634a",
  "name": "punks-erasure",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROMOTION_AUTHORITY_FAULTS",
        "class_name": "PromotionAuthorityFaultDO"
      }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PromotionAuthorityFaultDO"] }
  ],
  "r2_buckets": [
    {
      "binding": "ERASURE_TOMBSTONES",
      "bucket_name": "punks-erasure-local"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "local": {
      "name": "punks-erasure-local",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "local"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PROMOTION_AUTHORITY_FAULTS",
            "class_name": "PromotionAuthorityFaultDO"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ERASURE_TOMBSTONES",
          "bucket_name": "punks-erasure-local"
        }
      ]
    },
    "staging": {
      "name": "punks-erasure-staging",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PROMOTION_AUTHORITY_FAULTS",
            "class_name": "PromotionAuthorityFaultDO"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ERASURE_TOMBSTONES",
          "bucket_name": "punks-erasure-staging"
        }
      ]
    }
  }
}
