{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "account_id": "3a391620584c792dbbd8cfa148d7634a",
  "name": "punks-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ENVIRONMENT": "local",
    "PROMOTION_SESSION_ISSUANCE_ENABLED": "false",
    "BOT_INVOCATION_CURRENT_KID": "local-v1",
    "AUTH_BASE_URL": "http://localhost:1420",
    "SESSION_TTL_SECONDS": "2592000",
    "GOOGLE_AUTHORIZATION_ENDPOINT": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_ENDPOINT": "https://oauth2.googleapis.com/token",
    "GOOGLE_USERINFO_ENDPOINT": "https://openidconnect.googleapis.com/v1/userinfo",
    "GITHUB_AUTHORIZATION_ENDPOINT": "https://github.com/login/oauth/authorize",
    "GITHUB_TOKEN_ENDPOINT": "https://github.com/login/oauth/access_token",
    "GITHUB_API_BASE_URL": "https://api.github.com"
  },
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "GITHUB_OAUTH_CLIENT_ID",
      "GITHUB_OAUTH_CLIENT_SECRET",
      "BOT_INVOCATION_CURRENT_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PUNKS", "class_name": "PunkDO" },
      { "name": "ACCOUNT_MERGE_INTENTS", "class_name": "AccountMergeIntentDO" },
      { "name": "IDENTITY_CLAIMS", "class_name": "IdentityClaimDO" },
      { "name": "EMAIL_CLAIMS", "class_name": "EmailClaimDO" },
      { "name": "AUTH_TRANSACTIONS", "class_name": "AuthTransactionDO" },
      { "name": "DESKTOP_AUTH_FLOWS", "class_name": "DesktopAuthFlowDO" },
      { "name": "DESKTOP_REAUTH_GRANTS", "class_name": "DesktopReauthGrantDO" },
      { "name": "SESSION_REVOCATIONS", "class_name": "SessionRevocationDO" },
      { "name": "SESSION_ROTATIONS", "class_name": "SessionRotationDO" },
      { "name": "SESSIONS", "class_name": "SessionDO" }
    ]
  },
  "services": [
    {
      "binding": "ACCOUNT_MERGE_RECEIPTS",
      "service": "punks-erasure",
      "entrypoint": "AccountMergeReceiptRegistryService",
      "props": {
        "role": "punks-account-merge-receipt-writer",
        "environment": "local"
      }
    },
    {
      "binding": "ACCOUNT_MERGE_WORKSPACES",
      "service": "punks-api",
      "entrypoint": "AccountMergeWorkspaceService",
      "props": {
        "role": "punks-account-merge-workspace-applicator",
        "environment": "local"
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PunkDO",
        "IdentityClaimDO",
        "EmailClaimDO",
        "AuthTransactionDO",
        "SessionDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PasskeyCeremonyDO", "PasskeyCredentialDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DesktopDeliveryDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["AccountMergeIntentDO"]
    },
    {
      "tag": "v5",
      "deleted_classes": ["DesktopDeliveryDO"],
      "new_sqlite_classes": [
        "DesktopAuthFlowDO",
        "DesktopReauthGrantDO",
        "SessionRevocationDO",
        "SessionRotationDO"
      ]
    },
    {
      // ADR-0064: permanently retire both dedicated passkey namespaces.
      "tag": "v6",
      "deleted_classes": ["PasskeyCeremonyDO", "PasskeyCredentialDO"]
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "punks-auth-staging",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [
        { "pattern": "staging.punks.bot/api/auth/*", "zone_name": "punks.bot" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PROMOTION_SESSION_ISSUANCE_ENABLED": "true",
        "BOT_INVOCATION_CURRENT_KID": "staging-v1",
        "AUTH_BASE_URL": "https://staging.punks.bot",
        "SESSION_TTL_SECONDS": "2592000",
        "GOOGLE_AUTHORIZATION_ENDPOINT": "https://accounts.google.com/o/oauth2/v2/auth",
        "GOOGLE_TOKEN_ENDPOINT": "https://oauth2.googleapis.com/token",
        "GOOGLE_USERINFO_ENDPOINT": "https://openidconnect.googleapis.com/v1/userinfo",
        "GITHUB_AUTHORIZATION_ENDPOINT": "https://github.com/login/oauth/authorize",
        "GITHUB_TOKEN_ENDPOINT": "https://github.com/login/oauth/access_token",
        "GITHUB_API_BASE_URL": "https://api.github.com"
      },
      "secrets": {
        "required": [
          "GOOGLE_OAUTH_CLIENT_ID",
          "GOOGLE_OAUTH_CLIENT_SECRET",
          "GITHUB_OAUTH_CLIENT_ID",
          "GITHUB_OAUTH_CLIENT_SECRET",
          "BOT_INVOCATION_CURRENT_SECRET"
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "PUNKS", "class_name": "PunkDO" },
          {
            "name": "ACCOUNT_MERGE_INTENTS",
            "class_name": "AccountMergeIntentDO"
          },
          { "name": "IDENTITY_CLAIMS", "class_name": "IdentityClaimDO" },
          { "name": "EMAIL_CLAIMS", "class_name": "EmailClaimDO" },
          { "name": "AUTH_TRANSACTIONS", "class_name": "AuthTransactionDO" },
          { "name": "DESKTOP_AUTH_FLOWS", "class_name": "DesktopAuthFlowDO" },
          {
            "name": "DESKTOP_REAUTH_GRANTS",
            "class_name": "DesktopReauthGrantDO"
          },
          {
            "name": "SESSION_REVOCATIONS",
            "class_name": "SessionRevocationDO"
          },
          { "name": "SESSION_ROTATIONS", "class_name": "SessionRotationDO" },
          { "name": "SESSIONS", "class_name": "SessionDO" }
        ]
      },
      "services": [
        {
          "binding": "ACCOUNT_MERGE_RECEIPTS",
          "service": "punks-erasure-staging",
          "entrypoint": "AccountMergeReceiptRegistryService",
          "props": {
            "role": "punks-account-merge-receipt-writer",
            "environment": "staging"
          }
        },
        {
          "binding": "ACCOUNT_MERGE_WORKSPACES",
          "service": "punks-api-staging",
          "entrypoint": "AccountMergeWorkspaceService",
          "props": {
            "role": "punks-account-merge-workspace-applicator",
            "environment": "staging"
          }
        }
      ]
    }
  }
}
