# Punks production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.

# Image published by the public image pipeline. Use `:main` for pre-release testing. Pin `:sha-<7>` or a semver release tag for production.
PUNKS_IMAGE=ghcr.io/punksbot/punksbot:main

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
PUNKS_DOMAIN=punks.example.com
RELAY_URL=wss://punks.example.com
PUNKS_MEDIA_BASE_URL=https://punks.example.com/media
PUNKS_MEDIA_SERVER_DOMAIN=punks.example.com
PUNKS_CORS_ORIGINS=https://punks.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
PUNKS_REQUIRE_AUTH_TOKEN=true
PUNKS_REQUIRE_RELAY_MEMBERSHIP=true
PUNKS_ALLOW_NIP_OA_AUTH=true
PUNKS_AUTO_MIGRATE=true
PUNKS_GIT_CONFORMANCE_PROBE=true
RUST_LOG=punks_relay=info,punks_db=info,punks_auth=info,punks_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
PUNKS_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
PUNKS_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=punks
POSTGRES_USER=punks
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
PUNKS_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
PUNKS_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
PUNKS_S3_BUCKET=punks-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
PUNKS_S3_ADDRESSING_STYLE=path

# Optional host ports. Base compose publishes the relay directly on PUNKS_HTTP_PORT.
PUNKS_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
